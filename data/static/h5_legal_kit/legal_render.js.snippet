  /* --- Legal modal kit (replace {prefix} in class names, e.g. paaow) --- */
  function escapeHtml(text) {
    return String(text)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  function isLegalSectionHeading(block) {
    if (!block || block.length > 72) return false;
    if (/^Latest Updated:/i.test(block)) return false;
    if (/\.\s+[A-Z]/.test(block)) return false;
    if (block.length > 48 && block.indexOf('.') > 0) return false;
    return /^[A-Z]/.test(block);
  }

  function formatLegalBody(raw) {
    var lines = String(raw || '').split('\n');
    var title = (lines[0] || '').trim();
    var i = 1;
    while (i < lines.length && !lines[i].trim()) i += 1;
    var meta = '';
    if (i < lines.length && /^Latest Updated:/i.test(lines[i].trim())) {
      meta = lines[i].trim();
      i += 1;
    }
    var blocks = [];
    var current = [];
    for (; i < lines.length; i++) {
      var line = lines[i].trim();
      if (!line) {
        if (current.length) {
          blocks.push(current.join(' '));
          current = [];
        }
        continue;
      }
      current.push(line);
    }
    if (current.length) blocks.push(current.join(' '));

    var bodyHtml = '';
    if (meta) {
      bodyHtml += '<p class="c-{prefix}-legal-meta">' + escapeHtml(meta) + '</p>';
    }
    for (var b = 0; b < blocks.length; b++) {
      var block = blocks[b];
      if (isLegalSectionHeading(block)) {
        bodyHtml += '<h2 class="c-{prefix}-legal-section">' + escapeHtml(block) + '</h2>';
      } else {
        bodyHtml += '<p class="c-{prefix}-legal-para">' + escapeHtml(block) + '</p>';
      }
    }
    return { title: title, bodyHtml: bodyHtml };
  }

  function renderLegal(params) {
    var doc = params.doc === 'terms' ? 'terms' : 'privacy';
    var formatted = formatLegalBody(U.LEGAL[doc]);
    var title = formatted.title || (doc === 'terms' ? 'User Agreement' : 'Privacy Agreement');
    return '<div class="u-{prefix}-veil-dialog" data-action="legal-close">' +
      '<div class="c-{prefix}-legal-card">' +
      '<div class="c-{prefix}-legal-header">' +
      '<h1 class="c-{prefix}-legal-title">' + escapeHtml(title) + '</h1>' +
      '<button type="button" class="c-{prefix}-legal-close" data-action="legal-close" aria-label="Close">' +
      mark('{prefix}-mark-close') + '</button></div>' +
      '<div class="c-{prefix}-legal-scroll">' + formatted.bodyHtml + '</div></div></div>';
  }
