/* Legal modal — append to {prefix}_baseline.css (replace {prefix} e.g. paaow) */
.c-{prefix}-legal-card {
  background: var(--{prefix}-surface);
  border-radius: 24px;
  width: min(90vw, 340px);
  max-height: 85vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  text-align: left;
  box-shadow: 0 12px 40px rgba(26, 18, 14, 0.18);
}
.c-{prefix}-legal-header {
  flex-shrink: 0;
  display: flex;
  align-items: flex-start;
  gap: var(--{prefix}-space-xs);
  padding: var(--{prefix}-space-md) var(--{prefix}-space-md) var(--{prefix}-space-sm);
  border-bottom: 1px solid color-mix(in srgb, var(--{prefix}-outline) 18%, transparent);
}
.c-{prefix}-legal-title {
  flex: 1;
  min-width: 0;
  margin: 0;
  padding-top: 6px;
  font-size: 16px;
  font-weight: 600;
  line-height: 1.25;
  color: var(--{prefix}-on-surface);
}
.c-{prefix}-legal-close {
  flex-shrink: 0;
  width: 44px;
  height: 44px;
  margin: 0;
  padding: 0;
  border: none;
  border-radius: var(--{prefix}-radius-md);
  background: var(--{prefix}-surface-variant);
  color: var(--{prefix}-on-surface);
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
}
.c-{prefix}-legal-close:active {
  background: color-mix(in srgb, var(--{prefix}-outline) 22%, var(--{prefix}-surface-variant));
}
.c-{prefix}-legal-scroll {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  padding: var(--{prefix}-space-md);
  scrollbar-width: none;
  mask-image: linear-gradient(to bottom, #000 calc(100% - 28px), transparent 100%);
}
.c-{prefix}-legal-scroll::-webkit-scrollbar { display: none; width: 0; height: 0; }
.c-{prefix}-legal-meta {
  margin: 0 0 var(--{prefix}-space-sm);
  font-size: var(--{prefix}-font-micro);
  line-height: 1.4;
  color: color-mix(in srgb, var(--{prefix}-on-surface) 62%, transparent);
}
.c-{prefix}-legal-section {
  margin: var(--{prefix}-space-md) 0 var(--{prefix}-space-xs);
  font-size: 14px;
  font-weight: 600;
  line-height: 1.3;
  color: var(--{prefix}-on-surface);
}
.c-{prefix}-legal-section:first-child { margin-top: 0; }
.c-{prefix}-legal-para {
  margin: 0 0 var(--{prefix}-space-sm);
  font-size: var(--{prefix}-font-micro);
  line-height: 1.55;
  color: var(--{prefix}-on-surface);
}
.c-{prefix}-legal-para:last-child { margin-bottom: 0; }
