.c-{{PREFIX}}-chip-rail {
  display: flex;
  gap: 8px;
  flex-wrap: nowrap;
  overflow-x: auto;
  overflow-y: hidden;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none;
  -ms-overflow-style: none;
  margin-bottom: var(--space-lg, 24px);
  padding-bottom: 2px;
}
.c-{{PREFIX}}-chip-rail::-webkit-scrollbar {
  display: none;
  width: 0;
  height: 0;
}
