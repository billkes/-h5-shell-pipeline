# h5-shell-pipeline 配置文件示例
# 复制为 config.yaml 后按需修改；环境变量优先级高于本文件。

defaults:
  pack_type: h5_swift_shell
  task_csv: task.csv

xcode:
  # 流水线测试阶段固定包名，不随应用名变化。
  bundle_id: test.duckegg.ios
  # duckeggkaifaProfile 归属团队（WanYing He）；勿与证书括号内个人 ID 混淆。
  team_id: "995HYU84B7"
  provisioning_profile: duckeggkaifaProfile

build:
  pub_get_max_retries: 3
  max_build_fix_rounds: 2

runtime:
  legacy_pipeline: false

# ui-ux-pro-max 设计系统（skill.design / skill.adapt / skill.enrich）
# 技能仓库须与流水线根目录「同级」，目录名固定为 ui-ux-pro-max-skill。
# 默认自动探测顺序：uupm.skill_dir > 环境变量 UUPM_SKILL_DIR >
#   <流水线根目录>/../ui-ux-pro-max-skill（当前布局即 .cursor/rules/ui-ux-pro-max-skill）。
# 保持同级关系即可零配置命中；skill_dir 仅在放到非同级路径时才需显式指定。
uupm:
  skill_dir: ""
  integrations:
    enrich_domains: true
    page_overrides: true
    token_sync: true
    icon_brief: true
    motion_css: true
    sibling_skills_link: true

# 可选：Logo/Icon AI 生成（design skill，无 key 时跳过）
design:
  gemini_api_key: ""
