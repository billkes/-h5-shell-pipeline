# h5-shell-pipeline 配置文件示例
# 复制为 config.yaml 后按需修改；环境变量优先级高于本文件。

defaults:
  pack_type: h5_swift_shell
  task_csv: task.csv

xcode:
  # 流水线测试阶段固定包名，不随应用名变化。
  bundle_id: test.duckegg.ios
  # duckeggkaifaProfile 归属团队（WanYing He）；勿与证书括号内个人 ID 混淆。
  team_id: "995HYU84B7"
  provisioning_profile: duckeggkaifaProfile

build:
  pub_get_max_retries: 3
  max_build_fix_rounds: 2

runtime:
  legacy_pipeline: false

# ui-ux-pro-max：prepare.context 克隆/复制进每个产包工作区
#   → .cursor/skills/ui-ux-pro-max/（真实文件，供 CLI / 桌面 / 网页 Agent）
# 设计由 agent.design 主产（不再跑 skill.design～skill.tokens 草稿链）。
# skill_git_url 默认官方仓；skill_git_ref 可钉 tag/branch/commit。
# skill_dir / UUPM_SKILL_DIR 仅作离线 fallback 复制源（Agent 不依赖本机路径）。
uupm:
  skill_git_url: "https://github.com/nextlevelbuilder/ui-ux-pro-max-skill.git"
  skill_git_ref: ""
  skill_dir: ""
  integrations:
    enrich_domains: true
    page_overrides: true
    token_sync: true
    icon_brief: true
    motion_css: true
    sibling_skills_link: true

# 产包 Agent 蒸馏语料（global-brain 白名单导出区）
# 流水线仓不存正文；V3 步骤 sync.distilled（lock 后、Agent 前）投影到
#   output/.../skill-input/distilled/
# 路径用绝对路径；按本机 OS 选 win / mac。找不到目录 → WARN 跳过，不硬失败。
# 单机覆盖：环境变量 AGENT_DISTILLED_SOURCE（任意 OS 优先于 win/mac）。
agent_distilled:
  enabled: true
  source_dir: ""
  source_dir_win: "E:/projects/global-brain/1_项目/h5-shell-pipeline/agent-distilled"
  source_dir_mac: "/Users/ios-dev/Desktop/projects/global-brain/1_项目/h5-shell-pipeline/agent-distilled"

# 可选：Logo/Icon AI 生成（design skill，无 key 时跳过）
design:
  gemini_api_key: ""
