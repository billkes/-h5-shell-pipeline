# h5-shell-pipeline 环境变量示例
# 复制为 config/config.env 后按需修改；环境变量优先级高于 config.yaml

# Agent
AGENT_PROVIDER=cursor
# CURSOR_CLI=cursor

# 默认包类型
BATCH_PACK_TYPE=h5_swift_shell

# H5 生产域名（产包必填）
# H5_PROD_HOST=test.darin.beauty

# Apple Team ID（Swift 壳产包必填）
# APPLE_TEAM_ID=YOURTEAMID

# 测试阶段固定 Bundle ID
XCODE_BUNDLE_ID=test.duckegg.ios

# 构建
PUB_GET_MAX_RETRIES=3
MAX_BUILD_FIX_ROUNDS=2
CURSOR_AGENT_PHASE_TIMEOUT_SEC=600
