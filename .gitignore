# Python 字节码缓存
__pycache__/
*.py[cod]
*$py.class

# 虚拟环境
.venv/

# 本地 API Key / 配置，勿提交
config/config.env
config/config.yaml

# 计划生成临时文件
.plan-gen/
.batch-queue-*.txt

# 批次产出目录（体积大，勿提交）
output/

# H5 部署产物（dev.h5.build 生成，勿提交；登记字段仍指向 h5_site/{appSlug}/）
**/h5_site/

# pick-theme 候选池 sidecar（按主题一次性，不跨批次复用）
task.csv.name-pools.json

# iFlow CLI session files（本地运行时生成，勿提交）
.iflow/acp/sessions/*.json
!.iflow/acp/sessions/settings.json
